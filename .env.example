# Server
PORT=5002

# JWT (use a long random string in production)
JWT_SECRET=change-me-super-secret-jwt-key-at-least-32-chars

# MongoDB Atlas
# Either set MONGO_URI directly, or fill in the three parts below.
MONGODB_USER=your_user
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your-cluster.xxxxx.mongodb.net

# Full URI (SRV). If empty, the app falls back to MONGODB_USER/PASSWORD/CLUSTER
MONGO_URI=mongodb+srv://your_user:your_password@your-cluster.xxxxx.mongodb.net/petfoodtn?retryWrites=true&w=majority&appName=petfoodtn

# Stripe (optional - leave empty to keep payments in demo mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
