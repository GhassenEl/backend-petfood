# Server
PORT=5002

# JWT (use a long random string in production)
JWT_SECRET=change-me-super-secret-jwt-key-at-least-32-chars

# SQL database
DATABASE_URL=file:./dev.db
DEMO_MODE=false

# Stripe (optional - leave empty to keep payments in demo mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_MOCK=1

# Microservices (optionnel — laisser vide pour monolithe local)
# PRODUCT_SERVICE_URL=http://127.0.0.1:5102
# ORDER_SERVICE_URL=http://127.0.0.1:5103
# USER_SERVICE_URL=http://127.0.0.1:5105
# VETERINARY_SERVICE_URL=http://127.0.0.1:5101
# PRODUCT_SERVICE_PORT=5102
# ORDER_SERVICE_PORT=5103
# USER_SERVICE_PORT=5105
# VETERINARY_SERVICE_PORT=5101

# PayPal (optional — empty = demo mode)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MOCK=1
