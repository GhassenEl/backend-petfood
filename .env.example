# Server
PORT=5002

# JWT (use a long random string in production)
JWT_SECRET=change-me-super-secret-jwt-key-at-least-32-chars

# SQLite (local sans Docker)
DATABASE_URL=file:./dev.db

# PostgreSQL (avec Docker — voir docker-compose.yml et docs/POSTGRES.md)
# Changer aussi schema.prisma : provider = "postgresql"
# DATABASE_URL=postgresql://petfood:petfood@localhost:5432/petfoodtn?schema=public

DEMO_MODE=false

# Service ML Python (FastAPI + XGBoost) — port 8000
ML_SERVICE_URL=http://127.0.0.1:8000
ML_USE_XGBOOST=true
ML_TIMEOUT_MS=8000

# Stripe (optional - leave empty to keep payments in demo mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_MOCK=1

# Architecture : MONOLITHE uniquement (un seul serveur :5002)
# Ne pas définir PRODUCT_SERVICE_URL, ORDER_SERVICE_URL, USER_SERVICE_URL, VETERINARY_SERVICE_URL

# PayPal (optional — empty = demo mode)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MOCK=1

# Firebase Firestore — grandeurs IoT distributeur (section client)
# Compte de service : Firebase Console → Paramètres → Comptes de service
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# VPN WireGuard — endpoints distributeur IoT (optionnel)
# FEEDER_REQUIRE_VPN=true
# VPN_ALLOWED_CIDRS=10.13.13.0/24
