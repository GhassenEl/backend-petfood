{
  "name": "petfood-backend",
  "version": "1.0.0",
  "description": "Backend for PetfoodTN app with Prisma/PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:gateway": "nodemon server.js",
    "seed": "node seed.js",
    "seed:missing": "node scripts/seed-missing.js",
    "seed:platform": "node scripts/seed-missing.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "node scripts/db-setup.js",
    "postgres:up": "docker compose up -d",
    "postgres:down": "docker compose down",
    "test:api": "node scripts/test-wallet-api.js",
    "test:ml": "node --test tests/ml-architectures.test.js",
    "ml:benchmark": "node scripts/test-ml-models.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.1",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.0",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^22.1.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.14.1"
  },
  "prisma": {
    "seed": "node seed.js"
  }
}
