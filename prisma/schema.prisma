generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                     @id @default(uuid())
  email              String                     @unique
  password           String
  name               String
  phone              String?
  address            String?
  location           String?
  region             String?
  role               String                     @default("client")
  isActive           Boolean                    @default(true)
  petType            String?
  petAge             Int?
  preferences        String?
  favoriteCategories String?
  createdAt          DateTime                   @default(now())
  abusiveReports     Int                        @default(0)
  chatMessages       ChatMessage[]
  complaints         Complaint[]
  invoices           Invoice[]
  messagesReceived   Message[]                  @relation("ReceiverMessages")
  messagesSent       Message[]                  @relation("SenderMessages")
  orders             Order[]
  pets               Pet[]
  petWeightLogs      PetWeightLog[]
  petWaterMonitors   PetWaterMonitor[]
  petWaterReadings   PetWaterReading[]
  petAppointments    PetAppointment[]
  petVaccines        PetVaccine[]
  reviews            Review[]
  contactRequests    VeterinaryContactRequest[]
  veterinaryRecords  VeterinaryRecord[]
  vetAppointments    PetAppointment[]           @relation("VetAppointments")
  vetConsultations   VetConsultation[]          @relation("VetConsultations")
  ownerConsultations VetConsultation[]          @relation("OwnerConsultations")
  vetPrescriptions   Prescription[]             @relation("VetPrescriptions")
  ownerPrescriptions Prescription[]             @relation("OwnerPrescriptions")
  petFeeders         PetFeeder[]
  nutritionPlans     NutritionPlan[]
  leaveRequests      LeaveRequest[]
  createdDossiers    PetMedicalDossier[]        @relation("DossierCreator")
  signedEntries      MedicalDossierEntry[]      @relation("EntrySigner")
  petMedicalDossiers PetMedicalDossier[]
  loyaltyPoints      Int                        @default(0)
  vipTier            String                     @default("standard")
  gamificationXp     Int                        @default(0)
  productFavorites   ProductFavorite[]
  vendor             Vendor?
  subscriptions      ProductSubscription[]
  userBadges         UserBadge[]
  challengeProgress  UserChallengeProgress[]
  adoptionRequests   AdoptionApplication[]
  imageAnalyses      ImageAnalysis[]
  emotionAnalyses    EmotionAnalysis[]
  premiumReports     PremiumAiReport[]
  petCareBookings    PetCareBooking[]           @relation("PetCareClient")
  petCareProvider    PetCareProvider?
  loyaltyLedger      LoyaltyLedger[]
  loyaltyVouchers    LoyaltyVoucher[]
  serviceRatings     ServiceRating[]
  walletBalance      Float                      @default(0)
  walletTransactions WalletTransaction[]
  foundMeReports     PetFoundMeReport[]
  vetClinicalAnalyses VetClinicalAiAnalysis[]
  petEventRegistrations PetEventRegistration[]
  refundRequests     RefundRequest[]
  householdsOwned    Household[]              @relation("HouseholdOwner")
  householdMemberships HouseholdMember[]      @relation("HouseholdMemberships")
}

model PetFeeder {
  id              String           @id @default(uuid())
  ownerId         String
  petId           String?
  name            String           @default("Distributeur PetfoodTN")
  deviceKey       String           @unique
  macAddress      String?
  status          String           @default("offline")
  reservoirCm     Float?
  foodGrams       Float?
  temperature     Float?
  humidity        Float?
  animalPresent   Boolean          @default(false)
  isLowFood       Boolean          @default(false)
  pendingCommand  String?
  lastSeenAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  owner           User             @relation(fields: [ownerId], references: [id])
  schedules       FeederSchedule[]
  logs            FeederLog[]
}

model FeederSchedule {
  id           String    @id @default(uuid())
  feederId     String
  petName      String?
  time         String
  portionGrams Float     @default(30)
  enabled      Boolean   @default(true)
  label        String?
  createdAt    DateTime  @default(now())
  feeder       PetFeeder @relation(fields: [feederId], references: [id], onDelete: Cascade)
}

model FeederLog {
  id              String    @id @default(uuid())
  feederId        String
  eventType       String
  portionGrams    Float?
  animalDetected  Boolean?
  reservoirCm     Float?
  foodGrams       Float?
  temperature     Float?
  humidity        Float?
  message         String?
  createdAt       DateTime  @default(now())
  feeder          PetFeeder @relation(fields: [feederId], references: [id], onDelete: Cascade)
}

model NutritionPlan {
  id        String   @id @default(uuid())
  ownerId   String
  petId     String?
  petName   String?
  petType   String?
  goal      String?
  planText  String
  source    String   @default("nutripro")
  metadata  String?
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Pet {
  id               String    @id @default(uuid())
  ownerId          String
  name             String
  type             String
  breed            String?
  birthDate        DateTime?
  weight           Float?
  notes            String?
  passportNumber   String?   @unique
  microchipId      String?
  sex              String?
  color            String?
  createdAt        DateTime  @default(now())
  owner            User      @relation(fields: [ownerId], references: [id])
  dossier          PetMedicalDossier?
  foundMeReports   PetFoundMeReport[]
  weightLogs       PetWeightLog[]
  waterMonitors    PetWaterMonitor[]
  waterReadings    PetWaterReading[]
}

/// Historique de poids (suivi intelligent)
model PetWeightLog {
  id         String   @id @default(uuid())
  petId      String
  ownerId    String
  weightKg   Float
  note       String?
  source     String   @default("manual")
  recordedAt DateTime @default(now())
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([petId, recordedAt])
  @@index([ownerId])
}

/// Fontaine / bol connecté — surveillance hydratation
model PetWaterMonitor {
  id            String            @id @default(uuid())
  ownerId       String
  petId         String?
  name          String            @default("Fontaine connectée")
  status        String            @default("online")
  lastSeenAt    DateTime?
  reservoirMl   Int?
  dailyTargetMl Int?
  createdAt     DateTime          @default(now())
  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pet           Pet?              @relation(fields: [petId], references: [id], onDelete: SetNull)
  readings      PetWaterReading[]

  @@index([ownerId])
  @@index([petId])
}

/// Lectures consommation d'eau (IoT ou saisie manuelle)
model PetWaterReading {
  id         String           @id @default(uuid())
  monitorId  String?
  petId      String
  ownerId    String
  volumeMl   Float
  eventType  String           @default("consumption")
  source     String           @default("iot")
  recordedAt DateTime         @default(now())
  monitor    PetWaterMonitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  pet        Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([petId, recordedAt])
  @@index([ownerId])
  @@index([monitorId])
}

model Product {
  id            String      @id @default(uuid())
  name          String
  price         Float
  discountPrice Float?      @default(0)
  discount      Float?      @default(0)
  isOnSale      Boolean     @default(false)
  imageUrl      String?
  image         String?
  icon          String?
  description   String?
  stock         Int         @default(0)
  category      String      @default("nourriture")
  animalType    String      @default("other")
  tags          String?
  popularity    Float       @default(0)
  rating_avg    Float       @default(0)
  rating_count  Int         @default(0)
  stockHistory  String?
  createdAt     DateTime    @default(now())
  orderItems    OrderItem[]
  reviews       Review[]
  favorites     ProductFavorite[]
  vendorOffers  VendorProduct[]
  subscriptions ProductSubscription[]
  traceability  ProductTraceability?
}

model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  label          String?
  discountType   String    @default("percent")
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  maxUses        Int?
  usedCount      Int       @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  total            Float
  subtotal         Float?
  promoCodeId      String?
  promoCodeText    String?
  promoDiscount    Float       @default(0)
  status           String      @default("pending")
  paymentMethod    String      @default("cash")
  address          String?
  phone            String?
  region           String?
  deliveryLocation String?
  deliveryStatus   String      @default("pending")
  assignedLivreurId String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  deliveryNote     String?
  deliveryMode     String      @default("home")
  relayPointId     String?
  relayPointName   String?
  relayPointType   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  invoice          Invoice?
  messages         Message[]
  user             User        @relation(fields: [userId], references: [id])
  promoCode        PromoCode?  @relation(fields: [promoCodeId], references: [id])
  items            OrderItem[]
  serviceRatings   ServiceRating[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  quantity  Int
  price     Float
  product   Product? @relation(fields: [productId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
}

model Review {
  id             String   @id @default(uuid())
  userId         String
  productId      String
  rating         Int
  comment        String
  emotion        String   @default("neutral")
  sentiment      String?
  sentimentScore Float?
  aiSuggested      Boolean  @default(false)
  moderationStatus String   @default("approved")
  createdAt        DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model ServiceRating {
  id             String   @id @default(uuid())
  userId         String
  type           String
  rating         Int
  comment        String?
  emotion        String   @default("neutral")
  sentiment      String?
  sentimentScore Float?
  aiSuggested    Boolean  @default(false)
  region         String?
  orderId        String?
  appointmentId  String?
  bookingId      String?
  targetUserId   String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  order          Order?   @relation(fields: [orderId], references: [id])

  @@unique([userId, orderId])
  @@unique([userId, appointmentId])
  @@unique([userId, bookingId])
}

model ProductFavorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model LoyaltyLedger {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model LoyaltyVoucher {
  id           String    @id @default(uuid())
  userId       String
  code         String    @unique
  discountType String    @default("percent")
  discountValue Float
  pointsCost   Int
  usedAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id           String   @id @default(uuid())
  userId       String
  amount       Float
  type         String
  reason       String
  referenceId  String?
  balanceAfter Float
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Complaint {
  id                 String    @id @default(uuid())
  userId             String?
  email              String?
  name               String?
  subject            String
  message            String
  orderId            String?
  status             String    @default("pending")
  response           String?
  aiCategory         String?
  aiPriority         String?
  aiProposedResponse String?
  aiResolutionPlan   String?
  aiConfidence       Float?
  aiProcessedAt      DateTime?
  adminValidated     Boolean   @default(false)
  validatedBy        String?
  validatedAt        DateTime?
  createdAt          DateTime  @default(now())
  user               User?     @relation(fields: [userId], references: [id])
}

model Invoice {
  id            String    @id @default(uuid())
  userId        String
  orderId       String    @unique
  amount        Float
  status        String    @default("unpaid")
  paymentMethod String    @default("cash")
  issuedAt      DateTime  @default(now())
  paidAt        DateTime?
  order         Order     @relation(fields: [orderId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id           String   @id @default(uuid())
  userId       String
  role         String
  content      String
  products     String?
  quickReplies String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Message {
  id           String   @id @default(uuid())
  senderType   String
  senderId     String
  receiverType String
  receiverId   String?
  orderId      String?
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        Order?   @relation(fields: [orderId], references: [id])
  receiver     User?    @relation("ReceiverMessages", fields: [receiverId], references: [id])
  sender       User     @relation("SenderMessages", fields: [senderId], references: [id])
}

model PetAppointment {
  id           String           @id @default(uuid())
  ownerId      String
  vetId        String?
  petName      String
  animalType   String
  type         String
  category     String           @default("vet")
  title        String?
  isPublic     Boolean          @default(false)
  date         DateTime
  status       String           @default("scheduled")
  notes        String?
  meetingLink  String?
  visitMode    String           @default("cabinet")
  homeAddress  String?
  reminderSent Boolean          @default(false)
  price          Float?
  endDate        DateTime?
  paymentStatus  String           @default("unpaid")
  paymentMethod  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  owner        User             @relation(fields: [ownerId], references: [id])
  vet          User?            @relation("VetAppointments", fields: [vetId], references: [id])
  consultation VetConsultation?
  eventVenue     String?
  eventCapacity  Int?
  eventPrizes    String?
  competitionStatus String?  @default("open")
  registrations  PetEventRegistration[]
}

model PetEventRegistration {
  id        String         @id @default(uuid())
  eventId   String
  userId    String
  petName   String?
  status    String         @default("registered")
  entryNumber String?
  prizeLabel  String?
  prizeType   String?
  wonAt       DateTime?
  createdAt DateTime       @default(now())
  event     PetAppointment @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model MarketingCampaign {
  id          String    @id @default(uuid())
  name        String
  channel     String    @default("email")
  segmentSlug String
  subject     String?
  message     String
  promoCode   String?
  status      String    @default("draft")
  targeted    Int       @default(0)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([segmentSlug, status])
}

model VetConsultation {
  id              String         @id @default(uuid())
  appointmentId   String         @unique
  vetId           String
  ownerId         String
  petName         String
  animalType      String
  symptoms        String?
  clinicalExam    String?
  analysis        String?
  diagnosis       String?
  recommendations String?
  status          String         @default("draft")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  appointment     PetAppointment @relation(fields: [appointmentId], references: [id])
  vet             User           @relation("VetConsultations", fields: [vetId], references: [id])
  owner           User           @relation("OwnerConsultations", fields: [ownerId], references: [id])
  prescriptions   Prescription[]
}

model Prescription {
  id             String           @id @default(uuid())
  consultationId String?
  vetId          String
  ownerId        String
  petName        String
  medications    String
  instructions   String?
  validUntil     DateTime?
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  consultation   VetConsultation? @relation(fields: [consultationId], references: [id])
  vet            User             @relation("VetPrescriptions", fields: [vetId], references: [id])
  owner          User             @relation("OwnerPrescriptions", fields: [ownerId], references: [id])
}

model PetVaccine {
  id               String    @id @default(uuid())
  ownerId          String
  petName          String
  animalType       String
  vaccineType      String
  dateAdministered DateTime  @default(now())
  expiryDate       DateTime?
  nextDue          DateTime?
  batchNumber      String?
  vetNotes         String?
  status           String    @default("up_to_date")
  reminderSent     Boolean   @default(false)
  reminderAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  owner            User      @relation(fields: [ownerId], references: [id])
}

model VeterinaryRecord {
  id          String    @id @default(uuid())
  petName     String
  animalType  String    @default("dog")
  breed       String?
  sex         String?
  birthDate   DateTime?
  identificationNumber String?
  sterilized  Boolean?
  allergies   String?
  diet        String?
  activityLevel String?
  chronicDiseases String?
  ownerId     String
  petIndex    Int?
  ownerName   String?
  visitDate   DateTime  @default(now())
  diagnosis   String
  treatment   String?
  vetNotes    String?
  nextVisit   DateTime?
  weight      Float?
  temperature Float?
  medications String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id])
}

model VeterinaryContactRequest {
  id            String    @id @default(uuid())
  ownerId       String
  animalType    String
  petName       String?
  subject       String
  message       String
  preferredDate DateTime?
  visitMode     String    @default("cabinet")
  homeAddress   String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  owner         User      @relation(fields: [ownerId], references: [id])
}

/// Pharmacie partenaire du cabinet vétérinaire
model Pharmacy {
  id           String          @id @default(uuid())
  name         String
  address      String?
  phone        String?
  email        String?
  isPartner    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  medications  VetMedication[]
  imports      PharmacyImport[]
}

/// Référentiel maladies (normalisation BI)
model Disease {
  id          String             @id @default(uuid())
  name        String             @unique
  animalTypes String             @default("dog,cat")
  description String?
  createdAt   DateTime           @default(now())
  treatments  DiseaseTreatment[]
}

/// Catalogue médicaments vétérinaires (stock pharmacie)
model VetMedication {
  id           String             @id @default(uuid())
  name         String
  unit         String             @default("unité")
  stockQty     Int                @default(0)
  minStock     Int                @default(5)
  price        Float?
  pharmacyId   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  pharmacy     Pharmacy?          @relation(fields: [pharmacyId], references: [id])
  treatments   DiseaseTreatment[]

  @@unique([name, pharmacyId])
}

/// Mapping maladie → traitement médical recommandé
model DiseaseTreatment {
  id              String        @id @default(uuid())
  diseaseId       String
  medicationId    String
  defaultDosage   String?
  defaultFrequency String?
  defaultDuration String?
  defaultQuantity Int           @default(1)
  notes           String?
  createdAt       DateTime      @default(now())
  disease         Disease       @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  medication      VetMedication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([diseaseId, medicationId])
}

/// Journal d'import pharmacie (médicaments manquants réapprovisionnés)
model PharmacyImport {
  id           String   @id @default(uuid())
  pharmacyId   String
  importedBy   String?
  fileName     String?
  itemsCount   Int      @default(0)
  itemsJson    String?
  status       String   @default("completed")
  createdAt    DateTime @default(now())
  pharmacy     Pharmacy @relation(fields: [pharmacyId], references: [id])
}

/// Congé ou arrêt maladie — vétérinaire / livreur, validation admin
model LeaveRequest {
  id          String    @id @default(uuid())
  userId      String
  staffRole   String
  type        String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String    @default("pending")
  adminNote   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
}

/// Dossier médical numérique — un par animal patient
model PetMedicalDossier {
  id                   String                @id @default(uuid())
  dossierNumber        String                @unique
  ownerId              String
  petId                String?               @unique
  petName              String
  animalType           String                @default("dog")
  breed                String?
  sex                  String?
  birthDate            DateTime?
  identificationNumber String?
  sterilized           Boolean?
  allergies            String?
  chronicDiseases      String?
  diet                 String?
  bloodType            String?
  status               String                @default("active")
  createdByVetId       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  owner                User                  @relation(fields: [ownerId], references: [id])
  pet                  Pet?                  @relation(fields: [petId], references: [id])
  creator              User?                 @relation("DossierCreator", fields: [createdByVetId], references: [id])
  entries              MedicalDossierEntry[]

  @@index([ownerId, petName])
}

/// Entrée du dossier (consultation, vaccin, examen…) avec signature numérique vétérinaire
model MedicalDossierEntry {
  id                 String            @id @default(uuid())
  dossierId          String
  vetId              String
  entryType          String            @default("consultation")
  title              String
  symptoms           String?
  clinicalExam       String?
  diagnosis          String?
  treatment          String?
  medications        String?
  recommendations    String?
  weight             Float?
  temperature        Float?
  visitDate          DateTime          @default(now())
  status             String            @default("draft")
  isSigned           Boolean           @default(false)
  signedAt           DateTime?
  signedByVetId      String?
  vetSignatureImage  String?
  signatureHash      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  dossier            PetMedicalDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  signer             User?             @relation("EntrySigner", fields: [signedByVetId], references: [id])

  @@index([dossierId, visitDate])
}

/// Analyse IA anomalies animal — historique vétérinaire (urgent / non urgent, maladie)
model VetClinicalAiAnalysis {
  id               String   @id @default(uuid())
  vetId            String
  ownerId          String?
  petId            String?
  petName          String
  animalType       String   @default("dog")
  symptoms         String
  vitalsJson       String?
  urgency          String   @default("routine")
  urgencyClass     String   @default("non_urgent")
  diseaseSuspected Boolean  @default(false)
  anomaliesJson    String?
  analysisJson     String
  dossierEntryId   String?
  prescriptionId   String?
  followUpDays     Int?
  createdAt        DateTime @default(now())
  vet              User     @relation(fields: [vetId], references: [id])

  @@index([vetId, createdAt])
  @@index([ownerId, petName])
}

/// Retrouvé Moi — signalements animal perdu ou trouvé
model PetFoundMeReport {
  id                String    @id @default(uuid())
  tagCode           String    @unique
  reportType        String
  reporterId        String
  petId             String?
  petName           String
  animalType        String
  breed             String?
  color             String?
  distinctiveMarks  String?
  description       String?
  photoUrl          String?
  lastSeenAt        DateTime?
  location          String
  region            String?
  latitude          Float?
  longitude         Float?
  contactPhone      String?
  contactEmail      String?
  rewardOffered     String?
  status            String    @default("active")
  matchedReportId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  reporter          User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  pet               Pet?      @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([reportType, status])
  @@index([animalType, status])
  @@index([region])
}

/// Article de blog nutrition — publié par l'admin, lu par les clients
model BlogArticle {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("Guide")
  excerpt   String
  body      String
  readMin   Int      @default(5)
  isPublished Boolean @default(true)
  publishedAt DateTime @default(now())
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
}

/// Points relais partenaires — retrait animalerie / clinique
model PartnerRelayPoint {
  id          String   @id @default(uuid())
  name        String
  type        String
  address     String
  region      String?
  city        String?
  lat         Float?
  lng         Float?
  phone       String?
  hours       String?
  partnerCode String?
  isActive    Boolean  @default(true)
  vendorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isActive])
  @@index([region])
}

/// Marketplace — vendeur / animalerie
model Vendor {
  id              String          @id @default(uuid())
  ownerUserId     String          @unique
  shopName        String
  slug            String          @unique
  description     String?
  region          String?
  commissionRate  Float           @default(0.12)
  isActive           Boolean         @default(true)
  applicationStatus  String          @default("approved")
  commercialSiret    String?
  commercialAddress  String?
  commercialCategory String?
  commercialVerified Boolean         @default(false)
  totalSales         Float           @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  owner           User            @relation(fields: [ownerUserId], references: [id])
  products        VendorProduct[]
  commissions     VendorCommission[]
}

model VendorProduct {
  id         String   @id @default(uuid())
  vendorId   String
  productId  String
  price      Float?
  stock      Int      @default(0)
  isActive         Boolean  @default(true)
  moderationStatus String   @default("approved")
  imageFlag        String?
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vendorId, productId])
}

model VendorCommission {
  id           String   @id @default(uuid())
  vendorId     String
  orderId      String?
  orderTotal   Float
  commission   Float
  platformFee  Float
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
}

/// Abonnement livraison automatique
model ProductSubscription {
  id               String    @id @default(uuid())
  userId           String
  productId        String
  petName          String?
  quantity         Int       @default(1)
  frequencyDays    Int       @default(30)
  discountPercent  Float     @default(10)
  status           String    @default("active")
  nextDeliveryAt   DateTime
  pausedUntil      DateTime?
  address          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id])

  @@index([userId, status])
}

/// Refuge & adoption
model Shelter {
  id          String          @id @default(uuid())
  name        String
  region      String?
  address     String?
  phone       String?
  email       String?
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  animals     ShelterAnimal[]
}

model ShelterAnimal {
  id            String              @id @default(uuid())
  shelterId     String
  name          String
  species       String
  breed         String?
  ageYears      Int?
  sex           String?
  photoUrl      String?
  status        String              @default("available")
  description   String?
  origin        String              @default("abandoned")
  fearLevel     Int                 @default(3)
  isScared      Boolean             @default(false)
  rehabStatus   String              @default("intake")
  traumaNotes   String?
  createdAt     DateTime            @default(now())
  shelter       Shelter             @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  applications  AdoptionApplication[]
  rehabProgram  PetRehabilitationProgram?
}

/// Programme réhabilitation — animaux abandonnés / effrayés
model PetRehabilitationProgram {
  id              String                    @id @default(uuid())
  shelterAnimalId String                    @unique
  phase           String                    @default("trust")
  progressPercent Int                       @default(0)
  targetWeeks     Int                       @default(8)
  startedAt       DateTime                  @default(now())
  completedAt     DateTime?
  goalsJson       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  animal          ShelterAnimal             @relation(fields: [shelterAnimalId], references: [id], onDelete: Cascade)
  treatments      PetRehabilitationTreatment[]

  @@index([phase])
}

model PetRehabilitationTreatment {
  id            String                 @id @default(uuid())
  programId     String
  treatmentType String
  title         String
  notes         String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  progressDelta Int                    @default(5)
  performedBy   String?
  createdAt     DateTime               @default(now())
  program       PetRehabilitationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, completedAt])
}

model AdoptionApplication {
  id              String        @id @default(uuid())
  shelterAnimalId String
  userId          String
  message         String?
  status          String        @default("pending")
  createdAt       DateTime      @default(now())
  animal          ShelterAnimal @relation(fields: [shelterAnimalId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Gamification
model Badge {
  id          String      @id @default(uuid())
  code        String      @unique
  label       String
  description String?
  icon        String      @default("🏅")
  xpRequired  Int         @default(0)
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model MonthlyChallenge {
  id           String                  @id @default(uuid())
  monthKey     String                  @unique
  title        String
  description  String?
  goalType     String
  goalValue    Int
  rewardPoints Int                     @default(50)
  rewardXp     Int                     @default(100)
  progress     UserChallengeProgress[]
}

model UserChallengeProgress {
  id          String           @id @default(uuid())
  userId      String
  challengeId String
  progress    Int              @default(0)
  completed   Boolean          @default(false)
  completedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   MonthlyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

/// Pet sitting & promenade
model PetCareProvider {
  id          String           @id @default(uuid())
  userId      String           @unique
  displayName String
  bio         String?
  types       String
  certified   Boolean          @default(false)
  hourlyRate  Float            @default(25)
  region      String?
  ratingAvg   Float            @default(5)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id])
  bookings    PetCareBooking[]
}

model PetCareBooking {
  id           String           @id @default(uuid())
  clientId     String
  providerId   String
  type         String
  petName      String
  animalType   String
  startAt      DateTime
  endAt        DateTime?
  visitMode    String           @default("home")
  address      String?
  notes        String?
  price        Float
  status       String           @default("pending")
  createdAt    DateTime         @default(now())
  client       User             @relation("PetCareClient", fields: [clientId], references: [id])
  provider     PetCareProvider  @relation(fields: [providerId], references: [id])

  @@index([clientId])
  @@index([providerId])
}

/// Analyse photo IA
model ImageAnalysis {
  id         String   @id @default(uuid())
  userId     String
  petName    String?
  imageHint  String?
  resultsJson String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Analyse émotions animal (vidéo / comportement)
model EmotionAnalysis {
  id          String   @id @default(uuid())
  userId      String
  petName     String?
  mediaHint   String?
  resultsJson String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Rapports IA Premium (plan alimentaire, budget, risques, besoins futurs)
model PremiumAiReport {
  id         String   @id @default(uuid())
  userId     String
  petId      String?
  petName    String?
  reportType String
  payloadJson String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reportType])
}

/// Traçabilité blockchain — origine & certifications produit
model ProductTraceability {
  id                 String   @id @default(uuid())
  productId          String   @unique
  batchCode          String
  originCountry      String
  originRegion       String?
  producerName       String?
  facilityName       String?
  harvestDate        DateTime?
  certificationsJson String
  chainJson          String
  rootHash           String
  lastBlockHash      String
  isVerified         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([batchCode])
  @@index([originCountry])
}

/// Demande de remboursement / retour (workflow vendeur → modérateur → admin)
model RefundRequest {
  id               String               @id @default(uuid())
  orderRef         String
  clientId         String?
  clientName       String
  vendorName       String
  productName      String
  amount           Float
  reason           String
  reasonCategory   String
  delayDays        Int?
  noReturnRequired Boolean              @default(false)
  status           String               @default("pending")
  returnReceived   Boolean              @default(false)
  returnReceivedAt DateTime?
  fraudScore       Float                @default(0.05)
  disputed         Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  client           User?                @relation(fields: [clientId], references: [id])
  history          RefundHistoryEntry[]

  @@index([orderRef])
  @@index([status])
  @@index([reasonCategory])
}

model RefundHistoryEntry {
  id        String        @id @default(uuid())
  refundId  String
  action    String
  actor     String
  actorRole String
  note      String?
  createdAt DateTime      @default(now())
  refund    RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
}

/// Journal actions modération
model ModerationAction {
  id            String   @id @default(uuid())
  action        String
  target        String
  moderatorId   String?
  moderatorName String?
  metadata      String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/// Politique plateforme remboursements (singleton id = "default")
model RefundPolicy {
  id                      String   @id @default("default")
  returnWindowDays        Int      @default(14)
  refundProcessingDays    Int      @default(5)
  moderatorEscalationDays Int      @default(3)
  autoRefundThresholdDt   Float    @default(50)
  requirePhotoEvidence    Boolean  @default(true)
  partialRefundEnabled    Boolean  @default(true)
  allowChangedMind        Boolean  @default(false)
  vendorMustConfirmReceipt Boolean @default(true)
  lateDeliveryGraceDays   Int      @default(2)
  lateDeliveryAutoApprove Boolean  @default(true)
  lateDeliveryMaxDays     Int      @default(30)
  updatedAt               DateTime @updatedAt
}

/// Fournisseur B2B — réapprovisionnement stock plateforme (grossiste, fabricant)
model SupplySupplier {
  id           String   @id @default(uuid())
  name         String
  category     String   @default("alimentation")
  contactName  String?
  email        String?
  phone        String?
  region       String?
  address      String?
  leadTimeDays Int      @default(7)
  minOrderDt   Float?
  rating       Float    @default(4.5)
  contractRef  String?
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, isActive])
  @@index([region])
}

/// Foyer familial — plusieurs propriétaires partagent animaux et commandes
model Household {
  id         String              @id @default(uuid())
  name       String              @default("Mon foyer")
  ownerId    String
  inviteCode String              @unique
  createdAt  DateTime            @default(now())
  owner      User                @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    HouseholdMember[]
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String
  userId      String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation("HouseholdMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

/// Politique de gouvernance des prix (singleton)
model PriceGovernancePolicy {
  id                              String   @id @default("default")
  requireVendorPriceApproval      Boolean  @default(true)
  maxPriceIncreasePercent         Float    @default(15)
  maxDiscountPercent              Float    @default(50)
  minProductPrice                 Float    @default(1)
  maxProductPrice                 Float    @default(5000)
  showVerifiedBadgeToClients      Boolean  @default(true)
  autoRejectSuspiciousPrices      Boolean  @default(true)
  priceUpdateCooldownHours        Int      @default(24)
  lastGlobalVerificationAt        DateTime?
  updatedAt                       DateTime @updatedAt
  createdAt                       DateTime @default(now())
}

/// Journal des mises à jour de prix
model PriceChangeLog {
  id          String    @id @default(uuid())
  productId   String
  productName String?
  oldPrice    Float
  newPrice    Float
  oldDiscount Float     @default(0)
  newDiscount Float     @default(0)
  changePct   Float?
  status      String    @default("applied")
  source      String    @default("admin")
  vendorName  String?
  reason      String?
  actorName   String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  appliedAt   DateTime?

  @@index([productId, createdAt])
  @@index([status])
}

/// Ville / zone de présence PetfoodTN
model PlatformCity {
  id                String    @id @default(uuid())
  name              String    @unique
  slug              String    @unique
  governorate       String
  lat               Float
  lng               Float
  isActive          Boolean   @default(true)
  deliveryEnabled   Boolean   @default(true)
  pickupEnabled     Boolean   @default(true)
  priority          Int       @default(0)
  launchDate        DateTime?
  storeAddress      String?
  storePhone        String?
  storeHours        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([governorate, isActive])
  @@index([priority])
}

/// Journal d'audit / activité plateforme (persistant)
model ActivityLog {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  actorRole String
  actorId   String?
  actorName String
  action    String
  target    String?
  details   String?
  module    String   @default("platform")
  ip        String?
  userAgent String?

  @@index([at])
  @@index([actorRole])
  @@index([module])
  @@index([action])
}
